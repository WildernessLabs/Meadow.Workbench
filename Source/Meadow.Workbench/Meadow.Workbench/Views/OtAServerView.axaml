<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Meadow.Workbench.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:DataType="vm:OtAServerViewModel"
             x:Class="Meadow.Workbench.OtAServerView">

  <ScrollViewer>
    <StackPanel Margin="20" Spacing="15">

      <!-- Header -->
      <TextBlock Text="OTA Test Server"
                 FontSize="24" FontWeight="Bold"/>

      <!-- Server Control Section -->
      <Border BorderBrush="{DynamicResource SystemAccentColor}"
              BorderThickness="2" Padding="15" CornerRadius="5">
        <StackPanel Spacing="10">
          <TextBlock Text="Server Control" FontWeight="Bold" FontSize="16"/>

          <Grid ColumnDefinitions="Auto,*,Auto">
            <Button Grid.Column="0"
                    Content="{Binding StartStopButtonText}"
                    Command="{Binding ToggleServerCommand}"
                    Width="150"
                    HorizontalAlignment="Left"/>
            <TextBlock Grid.Column="2"
                       Text="{Binding ServerStatus}"
                       VerticalAlignment="Center"
                       Margin="15,0,0,0"
                       FontWeight="Bold"/>
          </Grid>

          <Separator/>

          <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="150,*">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="MQTT Broker:" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MqttBrokerUrl}" FontFamily="Consolas"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="HTTP Server:" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HttpServerUrl}" FontFamily="Consolas"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Connected Clients:" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ConnectedClients}"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Publish Update Section -->
      <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
              BorderThickness="1" Padding="15" CornerRadius="5">
        <StackPanel Spacing="10">
          <TextBlock Text="Publish Update" FontWeight="Bold" FontSize="16"/>

          <Label Content="Select Update Package:"/>
          <Grid ColumnDefinitions="*,Auto">
            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding AvailableUpdates}"
                      SelectedItem="{Binding SelectedUpdate}"
                      HorizontalAlignment="Stretch"
                      MinWidth="200"
                      Margin="0,0,10,0"/>
            <Button Grid.Column="1"
                    Content="Refresh"
                    Command="{Binding RefreshUpdatesCommand}"
                    VerticalAlignment="Stretch"/>
          </Grid>

          <Label Content="Target Device ID (empty = broadcast to all):"/>
          <TextBox Text="{Binding DeviceId}"
                   Watermark="machine-id or leave empty"
                   HorizontalAlignment="Stretch"/>

          <Button Content="Publish Selected Update"
                  Command="{Binding PublishUpdateCommand}"
                  IsEnabled="{Binding CanPublish}"
                  HorizontalAlignment="Left"
                  Width="200"
                  Height="40"
                  Margin="0,10,0,0"/>
        </StackPanel>
      </Border>

      <!-- Activity Log Section -->
      <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
              BorderThickness="1" Padding="15" CornerRadius="5" Background="#11000000">
        <StackPanel Spacing="10">
          <TextBlock Text="Activity Log" FontWeight="Bold" FontSize="16"/>
          <ScrollViewer Height="200" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ActivityLog}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}"
                             FontFamily="Consolas"
                             FontSize="11"
                             TextWrapping="Wrap"
                             Margin="0,2"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
